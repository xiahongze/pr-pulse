#!/usr/bin/env python3
"""Stand-in for `gh api graphql`, driven by FAKE_GH_MODE and FAKE_GH_FIXTURE."""
import json, os, sys, time
mode = os.environ.get("FAKE_GH_MODE", "ok")
if os.environ.get("FAKE_GH_ARGS"):
    with open(os.environ["FAKE_GH_ARGS"], "w") as handle:
        json.dump(sys.argv[1:], handle)
if mode == "unauthenticated":
    sys.stderr.write("To get started with GitHub CLI, please run:  gh auth login\n")
    sys.exit(4)
if mode == "network":
    sys.stderr.write('Post "https://api.github.com/graphql": dial tcp: lookup api.github.com: no such host\nerror connecting to api.github.com\n')
    sys.exit(1)
if mode == "slow":
    time.sleep(5)
with open(os.environ["FAKE_GH_FIXTURE"]) as handle:
    sys.stdout.write(handle.read())
sys.exit(1 if mode == "partial" else 0)
